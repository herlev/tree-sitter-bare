{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "bare",
      "camelcase": "Bare",
      "title": "BARE",
      "scope": "source.bare",
      "file-types": [
        "bare"
      ],
      "injection-regex": "^bare$",
      "class-name": "TreeSitterBare"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "BARE (Binary Application Record Encoding) grammar for tree-sitter",
    "authors": [
      {
        "name": "herlev",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/herlev/tree-sitter-bare",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}